# Database Configuration (Required)
DATABASE_URL=
DATABASE_SSL=false
DATABASE_SSL_CA=

# Server Configuration
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# Authentication (Required)
AUTH_MODE=oidc
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
OIDC_CLIENT_ID=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_SCOPES=openid profile email
OIDC_TENANT_CLAIM=tenant_id
JWT_SECRET=
CORS_ORIGINS=http://localhost:3001
ALLOWED_HOSTS=localhost,127.0.0.1
DEFAULT_TENANT_ID=default
TENANT_ENFORCEMENT=compatibility
ENABLE_TEST_ENDPOINTS=true
FEATURE_SPORTS_CONTRACTS=true
FEATURE_SMART_CONTRACT_ASSURANCE=true

# API Keys (Required)
SAM_GOV_API_KEY=
NORSHIN_API_KEY=

# AI Service Configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
RFP_MAX_TOKENS=64000
RFP_REQUEST_TIMEOUT_MS=600000

# Norshin API for document processing
NORSHIN_API_URL=https://norshin.com/api/process-document

# Persistent local vector index
VECTOR_INDEX_PATH=./vector_indexes

# Durable work execution (use durable in production and run npm run worker)
PIPELINE_EXECUTION_MODE=inline
WORKER_CONCURRENCY=1
WORKER_POLL_MS=2000
WORKER_LEASE_MS=900000

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379

# File Upload Configuration
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=.pdf,.doc,.docx

# File Storage Directories
UPLOAD_DIR=./uploads
DOCUMENTS_DIR=./documents

# Protected document storage and malware scanning
DOCUMENT_STORAGE_PROVIDER=filesystem
MALWARE_SCAN_MODE=disabled
MALWARE_SCANNER_COMMAND=clamscan
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KMS_KEY_ID=
S3_RETENTION_DAYS=90
S3_FORCE_PATH_STYLE=true

# Encrypts notification destinations; use a secret-manager value in production
DATA_ENCRYPTION_KEY=
SMTP_URL=
NOTIFICATION_FROM=
MONITORING_TOKEN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=600
STATUS_RATE_LIMIT_MAX_REQUESTS=300
AI_RATE_LIMIT_MAX_REQUESTS=10
SUBMISSION_PACKAGE_ENFORCEMENT=advisory

# Reliability and encrypted backup volume
PIPELINE_MAINTENANCE_INTERVAL_MS=60000
BACKUP_DIRECTORY=
BACKUP_RETENTION_DAYS=30
BACKUP_HOST_DIRECTORY=
BACKUP_ENCRYPTION_KEY_HOST_FILE=
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RESTORE_TEST_ENABLED=true
RESTORE_TEST_DATABASE_URL=
