# Database Configuration (Required)
DATABASE_URL=
DATABASE_SSL=false
DATABASE_SSL_CA=

# Server Configuration
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# Authentication (Required)
AUTH_MODE=oidc
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
OIDC_CLIENT_ID=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_SCOPES=openid profile email
JWT_SECRET=
CORS_ORIGINS=http://localhost:3001
ALLOWED_HOSTS=localhost,127.0.0.1

# API Keys (Required)
SAM_GOV_API_KEY=
NORSHIN_API_KEY=

# AI Service Configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
RFP_MAX_TOKENS=64000
RFP_REQUEST_TIMEOUT_MS=600000

# Norshin API for document processing
NORSHIN_API_URL=https://norshin.com/api/process-document

# Persistent local vector index
VECTOR_INDEX_PATH=./vector_indexes

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379

# File Upload Configuration
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=.pdf,.doc,.docx

# File Storage Directories
UPLOAD_DIR=./uploads
DOCUMENTS_DIR=./documents

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_MAX_REQUESTS=10

# Reliability and encrypted backup volume
PIPELINE_MAINTENANCE_INTERVAL_MS=60000
BACKUP_DIRECTORY=
BACKUP_RETENTION_DAYS=30
