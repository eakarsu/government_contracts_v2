{
  "watch": [
    "server.js",
    "server",
    "config",
    "middleware",
    "routes",
    "services",
    "utils"
  ],
  "ignore": [
    "node_modules/**",
    "uploads/**",
    "documents/**",
    "logs/**",
    "client/**",
    "vector_indexes/**",
    "downloaded_documents/**",
    "queue_documents/**",
    "processed_queue_documents/**",
    "temp_*/**",
    ".git/**",
    "*.log",
    "*.pid"
  ],
  "ext": "js,json",
  "delay": 1000
}
