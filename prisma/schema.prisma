generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contract {
  id                    Int                    @id @default(autoincrement())
  noticeId              String                 @unique @map("notice_id")
  title                 String?
  description           String?
  agency                String?
  naicsCode             String?                @map("naics_code")
  classificationCode    String?                @map("classification_code")
  postedDate            DateTime?              @map("posted_date")
  responseDeadline      DateTime?              @map("response_deadline")
  placeOfPerformance    Json?                  @map("place_of_performance")
  setAsideCode          String?                @map("set_aside_code")
  resourceLinks         Json?                  @map("resource_links")
  samData               Json?                  @map("sam_data")
  samRetrievedAt        DateTime?              @map("sam_retrieved_at")
  indexedAt             DateTime?              @map("indexed_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  rfpResponses          RfpResponse[]
  complianceEvaluations ComplianceEvaluation[]
  lifecycleMatters      ContractMatter[]
  rfpAmendments         RfpAmendment[]

  @@index([responseDeadline])
  @@map("contract")
}

model IndexingJob {
  id               Int       @id @default(autoincrement())
  jobType          String    @map("job_type")
  status           String    @default("pending")
  startDate        DateTime? @map("start_date")
  endDate          DateTime? @map("end_date")
  recordsProcessed Int?      @map("records_processed")
  errorsCount      Int?      @map("errors_count")
  errorDetails     String?   @map("error_details")
  createdAt        DateTime  @default(now()) @map("created_at")
  completedAt      DateTime? @map("completed_at")

  @@map("indexing_job")
}

model SearchQuery {
  id           Int      @id @default(autoincrement())
  queryText    String   @map("query_text")
  resultsCount Int      @map("results_count")
  responseTime Float    @map("response_time")
  userIp       String?  @map("user_ip")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("search_query")
}

model User {
  id            Int                @id @default(autoincrement())
  email         String             @unique
  firstName     String?            @map("first_name")
  lastName      String?            @map("last_name")
  password      String
  isActive      Boolean            @default(true) @map("is_active")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  localSessions LocalAuthSession[]

  @@map("user")
}

model LocalAuthSession {
  tokenHash  String   @id @map("token_hash")
  userId     Int      @map("user_id")
  roles      String[] @default(["admin"])
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("local_auth_session")
}

model Company {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  website     String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("company")
}

model ContractApplication {
  id               Int      @id @default(autoincrement())
  contractNoticeId String   @map("contract_notice_id")
  companyId        Int      @map("company_id")
  status           String   @default("pending")
  submittedAt      DateTime @default(now()) @map("submitted_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("contract_application")
}

model AITemplate {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  template    String
  category    String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("ai_template")
}

model DocumentProcessingQueue {
  id               Int       @id @default(autoincrement())
  contractNoticeId String    @map("contract_notice_id")
  documentUrl      String    @map("document_url")
  description      String?
  localFilePath    String?   @map("local_file_path")
  filename         String?
  status           String    @default("queued")
  retryCount       Int       @default(0) @map("retry_count")
  maxRetries       Int       @default(3) @map("max_retries")
  processedData    String?   @map("processed_data")
  errorMessage     String?   @map("error_message")
  queuedAt         DateTime  @default(now()) @map("queued_at")
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  failedAt         DateTime? @map("failed_at")
  sourceChecksum   String?   @map("source_checksum")
  contentChecksum  String?   @map("content_checksum")
  lastAttemptAt    DateTime? @map("last_attempt_at")
  nextRetryAt      DateTime? @map("next_retry_at")
  deadLetteredAt   DateTime? @map("dead_lettered_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([status, nextRetryAt])
  @@index([sourceChecksum])
  @@map("document_processing_queue")
}

model RfpTemplate {
  id                 Int           @id @default(autoincrement())
  name               String
  agency             String?
  description        String?
  sections           String
  evaluationCriteria String        @map("evaluation_criteria")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  rfpResponses       RfpResponse[]

  @@map("rfp_templates")
}

model CompanyProfile {
  id           Int           @id @default(autoincrement())
  companyName  String        @map("company_name")
  profileData  String        @map("profile_data")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  rfpResponses RfpResponse[]

  @@map("company_profiles")
}

model RfpResponse {
  id               Int                          @id @default(autoincrement())
  contractId       String                       @map("contract_id")
  templateId       Int?                         @map("template_id")
  companyProfileId Int?                         @map("company_profile_id")
  title            String
  status           String                       @default("draft")
  responseData     String                       @map("response_data")
  complianceStatus String                       @map("compliance_status")
  predictedScore   Float?                       @map("predicted_score")
  createdAt        DateTime                     @default(now()) @map("created_at")
  updatedAt        DateTime                     @updatedAt @map("updated_at")
  companyProfile   CompanyProfile?              @relation(fields: [companyProfileId], references: [id])
  contract         Contract?                    @relation(fields: [contractId], references: [noticeId])
  template         RfpTemplate?                 @relation(fields: [templateId], references: [id])
  versions         RfpVersion[]
  requirements     RfpRequirement[]
  collaborators    RfpCollaborator[]
  approvals        RfpApproval[]
  checklistItems   RfpSubmissionChecklistItem[]
  submission       RfpSubmission?
  outcome          RfpOutcome?
  bidScores        RfpBidScore[]
  auditEvents      RfpAuditEvent[]
  comments         RfpComment[]

  @@map("rfp_responses")
}

model RfpVersion {
  id            Int         @id @default(autoincrement())
  rfpResponseId Int         @map("rfp_response_id")
  versionNumber Int         @map("version_number")
  changes       String
  snapshot      String?
  comment       String?
  createdBy     String      @map("created_by")
  createdAt     DateTime    @default(now()) @map("created_at")
  rfpResponse   RfpResponse @relation(fields: [rfpResponseId], references: [id], onDelete: Cascade)

  @@map("rfp_versions")
}

model RfpRequirement {
  id              String      @id @default(uuid())
  rfpResponseId   Int         @map("rfp_response_id")
  rfpResponse     RfpResponse @relation(fields: [rfpResponseId], references: [id], onDelete: Cascade)
  requirementKey  String      @map("requirement_key")
  text            String
  sourceType      String      @map("source_type")
  sourceLocator   String      @map("source_locator")
  evidenceRefs    Json        @map("evidence_refs")
  mappedSectionId String?     @map("mapped_section_id")
  coverageStatus  String      @default("UNMAPPED") @map("coverage_status")
  reviewStatus    String      @default("PENDING") @map("review_status")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@unique([rfpResponseId, requirementKey])
  @@index([rfpResponseId, coverageStatus])
  @@map("rfp_requirement")
}

model RfpCollaborator {
  id            String      @id @default(uuid())
  rfpResponseId Int         @map("rfp_response_id")
  rfpResponse   RfpResponse @relation(fields: [rfpResponseId], references: [id], onDelete: Cascade)
  email         String
  role          String
  assignedBy    String      @map("assigned_by")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@unique([rfpResponseId, email])
  @@index([email, role])
  @@map("rfp_collaborator")
}

model RfpApproval {
  id            String      @id @default(uuid())
  rfpResponseId Int         @map("rfp_response_id")
  rfpResponse   RfpResponse @relation(fields: [rfpResponseId], references: [id], onDelete: Cascade)
  gate          String
  cycle         Int         @default(1)
  reviewerEmail String      @map("reviewer_email")
  decision      String      @default("PENDING")
  rationale     String?
  assignedBy    String      @map("assigned_by")
  decidedBy     String?     @map("decided_by")
  decidedAt     DateTime?   @map("decided_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@unique([rfpResponseId, gate, cycle])
  @@index([reviewerEmail, decision])
  @@map("rfp_approval")
}

model RfpSubmissionChecklistItem {
  id            String      @id @default(uuid())
  rfpResponseId Int         @map("rfp_response_id")
  rfpResponse   RfpResponse @relation(fields: [rfpResponseId], references: [id], onDelete: Cascade)
  itemKey       String      @map("item_key")
  label         String
  required      Boolean     @default(true)
  completed     Boolean     @default(false)
  evidenceUrl   String?     @map("evidence_url")
  completedBy   String?     @map("completed_by")
  completedAt   DateTime?   @map("completed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@unique([rfpResponseId, itemKey])
  @@map("rfp_submission_checklist_item")
}

model RfpSubmission {
  id               String      @id @default(uuid())
  rfpResponseId    Int         @unique @map("rfp_response_id")
  rfpResponse      RfpResponse @relation(fields: [rfpResponseId], references: [id], onDelete: Cascade)
  destination      String
  submissionMethod String      @map("submission_method")
  trackingNumber   String?     @map("tracking_number")
  receipt          Json?
  status           String      @default("RECORDED")
  submittedBy      String      @map("submitted_by")
  submittedAt      DateTime    @map("submitted_at")
  createdAt        DateTime    @default(now()) @map("created_at")

  @@map("rfp_submission")
}

model RfpOutcome {
  id             String      @id @default(uuid())
  rfpResponseId  Int         @unique @map("rfp_response_id")
  rfpResponse    RfpResponse @relation(fields: [rfpResponseId], references: [id], onDelete: Cascade)
  outcome        String
  awardValue     Float?      @map("award_value")
  competitor     String?
  debrief        String?
  lessonsLearned Json?       @map("lessons_learned")
  recordedBy     String      @map("recorded_by")
  recordedAt     DateTime    @default(now()) @map("recorded_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@index([outcome, recordedAt])
  @@map("rfp_outcome")
}

model RfpBidScoringModel {
  id                 String        @id @default(uuid())
  name               String
  version            Int
  status             String        @default("CANDIDATE")
  trainingSampleSize Int           @map("training_sample_size")
  metrics            Json
  featureSchema      Json          @map("feature_schema")
  validatedBy        String?       @map("validated_by")
  validatedAt        DateTime?     @map("validated_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  scores             RfpBidScore[]

  @@unique([name, version])
  @@index([status, createdAt])
  @@map("rfp_bid_scoring_model")
}

model RfpBidScore {
  id            String              @id @default(uuid())
  rfpResponseId Int?                @map("rfp_response_id")
  rfpResponse   RfpResponse?        @relation(fields: [rfpResponseId], references: [id], onDelete: SetNull)
  contractId    String              @map("contract_id")
  modelId       String?             @map("model_id")
  model         RfpBidScoringModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
  probability   Float
  confidence    Float
  advisoryOnly  Boolean             @default(true) @map("advisory_only")
  features      Json
  factors       Json
  createdBy     String              @map("created_by")
  createdAt     DateTime            @default(now()) @map("created_at")

  @@index([contractId, createdAt])
  @@index([modelId, createdAt])
  @@map("rfp_bid_score")
}

model RfpAmendment {
  id               String    @id @default(uuid())
  contractId       String    @map("contract_id")
  contract         Contract  @relation(fields: [contractId], references: [noticeId], onDelete: Cascade)
  fingerprint      String
  previousSnapshot Json      @map("previous_snapshot")
  currentSnapshot  Json      @map("current_snapshot")
  changes          Json
  affectedSections Json      @map("affected_sections")
  detectedAt       DateTime  @default(now()) @map("detected_at")
  acknowledgedBy   String?   @map("acknowledged_by")
  acknowledgedAt   DateTime? @map("acknowledged_at")

  @@unique([contractId, fingerprint])
  @@index([contractId, detectedAt])
  @@map("rfp_amendment")
}

model RfpAuditEvent {
  id            String      @id @default(uuid())
  rfpResponseId Int         @map("rfp_response_id")
  rfpResponse   RfpResponse @relation(fields: [rfpResponseId], references: [id], onDelete: Cascade)
  sequence      Int
  action        String
  actorId       String      @map("actor_id")
  occurredAt    DateTime    @map("occurred_at")
  payload       Json
  previousHash  String      @map("previous_hash")
  hash          String      @unique

  @@unique([rfpResponseId, sequence])
  @@index([rfpResponseId, occurredAt])
  @@map("rfp_audit_event")
}

model RfpComment {
  id            String      @id @default(uuid())
  rfpResponseId Int         @map("rfp_response_id")
  rfpResponse   RfpResponse @relation(fields: [rfpResponseId], references: [id], onDelete: Cascade)
  sectionId     String?     @map("section_id")
  body          String
  authorId      String      @map("author_id")
  resolved      Boolean     @default(false)
  resolvedBy    String?     @map("resolved_by")
  resolvedAt    DateTime?   @map("resolved_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([rfpResponseId, resolved, createdAt])
  @@map("rfp_comment")
}

model GovernancePolicy {
  id            String                 @id @default(uuid())
  policyKey     String                 @map("policy_key")
  version       Int
  title         String
  jurisdiction  String
  effectiveFrom DateTime               @map("effective_from")
  effectiveTo   DateTime?              @map("effective_to")
  rules         Json
  createdBy     String                 @map("created_by")
  createdAt     DateTime               @default(now()) @map("created_at")
  evaluations   ComplianceEvaluation[]

  @@unique([policyKey, version])
  @@index([jurisdiction, effectiveFrom])
  @@map("governance_policy")
}

model RegulatorySource {
  id                 String                 @id @default(uuid())
  sourceKey          String                 @map("source_key")
  version            Int
  title              String
  authority          String
  documentIdentifier String                 @map("document_identifier")
  evidenceUrl        String                 @map("evidence_url")
  jurisdiction       String
  effectiveFrom      DateTime               @map("effective_from")
  effectiveTo        DateTime?              @map("effective_to")
  retrievedAt        DateTime               @map("retrieved_at")
  contentHash        String                 @map("content_hash")
  ingestedBy         String                 @map("ingested_by")
  supersedesId       String?                @map("supersedes_id")
  supersedes         RegulatorySource?      @relation("SourceVersions", fields: [supersedesId], references: [id])
  supersededBy       RegulatorySource[]     @relation("SourceVersions")
  evaluations        ComplianceEvaluation[]

  @@unique([sourceKey, version])
  @@index([jurisdiction, effectiveFrom])
  @@index([contentHash])
  @@map("regulatory_source")
}

model ComplianceEvaluation {
  id                String           @id @default(uuid())
  contractId        String           @map("contract_id")
  contract          Contract         @relation(fields: [contractId], references: [noticeId])
  scenario          String
  jurisdiction      String
  policyId          String           @map("policy_id")
  policy            GovernancePolicy @relation(fields: [policyId], references: [id])
  policyKey         String           @map("policy_key")
  policyVersion     Int              @map("policy_version")
  sourceId          String           @map("source_id")
  source            RegulatorySource @relation(fields: [sourceId], references: [id])
  sourceContentHash String           @map("source_content_hash")
  citations         Json
  evidenceLinks     Json             @map("evidence_links")
  obligations       Json
  deadlines         Json
  riskRating        String           @map("risk_rating")
  riskRationale     String           @map("risk_rationale")
  advisoryOutput    Json?            @map("advisory_output")
  ownerId           String           @map("owner_id")
  createdBy         String           @map("created_by")
  submittedBy       String?          @map("submitted_by")
  approvedBy        String?          @map("approved_by")
  decisionRationale String?          @map("decision_rationale")
  status            String           @default("DRAFT")
  evaluatedAt       DateTime         @map("evaluated_at")
  submittedAt       DateTime?        @map("submitted_at")
  approvedAt        DateTime?        @map("approved_at")
  immutableHash     String?          @unique @map("immutable_hash")
  retentionUntil    DateTime         @map("retention_until")
  legalHold         Boolean          @default(false) @map("legal_hold")
  legalHoldReason   String?          @map("legal_hold_reason")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@index([contractId, scenario])
  @@index([status, ownerId])
  @@index([retentionUntil, legalHold])
  @@map("compliance_evaluation")
}

model GovernanceAuditEvent {
  id            String   @id @default(uuid())
  aggregateType String   @map("aggregate_type")
  aggregateId   String   @map("aggregate_id")
  sequence      Int
  action        String
  actorId       String   @map("actor_id")
  occurredAt    DateTime @map("occurred_at")
  payload       Json
  previousHash  String   @map("previous_hash")
  hash          String   @unique

  @@unique([aggregateId, sequence])
  @@index([aggregateType, occurredAt])
  @@map("governance_audit_event")
}

model ContractMatter {
  id                String                       @id @default(uuid())
  contractNoticeId  String?                      @map("contract_notice_id")
  contract          Contract?                    @relation(fields: [contractNoticeId], references: [noticeId], onDelete: SetNull)
  matterNumber      String                       @unique @map("matter_number")
  title             String
  agency            String
  contractType      String                       @map("contract_type")
  jurisdiction      String
  stage             String                       @default("INTAKE")
  status            String                       @default("ACTIVE")
  ownerId           String                       @map("owner_id")
  createdBy         String                       @map("created_by")
  legalHold         Boolean                      @default(false) @map("legal_hold")
  retentionUntil    DateTime                     @map("retention_until")
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")
  parties           ContractParty[]
  documentVersions  ContractDocumentVersion[]
  clauses           ContractClause[]
  obligations       ContractObligation[]
  milestones        ContractMilestone[]
  amendments        ContractAmendment[]
  approvals         ContractApproval[]
  renewals          ContractRenewal[]
  riskAssessments   ContractRiskAssessment[]
  aiReviews         ContractAiReview[]
  integrationOutbox ContractIntegrationOutbox[]
  capabilityItems   ContractCapabilityWorkItem[]

  @@index([stage, status])
  @@index([ownerId, updatedAt])
  @@map("contract_matter")
}

model ContractParty {
  id              String         @id @default(uuid())
  matterId        String         @map("matter_id")
  matter          ContractMatter @relation(fields: [matterId], references: [id], onDelete: Cascade)
  name            String
  partyType       String         @map("party_type")
  contractRole    String         @map("contract_role")
  uei             String?
  cageCode        String?        @map("cage_code")
  riskRating      String         @default("LOW") @map("risk_rating")
  sanctionsStatus String         @default("CLEAR") @map("sanctions_status")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@unique([matterId, name, contractRole])
  @@index([matterId, partyType])
  @@map("contract_party")
}

model ContractDocumentVersion {
  id            String              @id @default(uuid())
  matterId      String              @map("matter_id")
  matter        ContractMatter      @relation(fields: [matterId], references: [id], onDelete: Cascade)
  documentType  String              @map("document_type")
  title         String
  version       Int
  sourceUrl     String?             @map("source_url")
  contentHash   String              @map("content_hash")
  privilege     String              @default("BUSINESS_CONFIDENTIAL")
  effectiveDate DateTime?           @map("effective_date")
  uploadedBy    String              @map("uploaded_by")
  createdAt     DateTime            @default(now()) @map("created_at")
  clauses       ContractClause[]
  amendments    ContractAmendment[]

  @@unique([matterId, title, version])
  @@index([matterId, documentType])
  @@map("contract_document_version")
}

model ContractClause {
  id                String                   @id @default(uuid())
  matterId          String                   @map("matter_id")
  matter            ContractMatter           @relation(fields: [matterId], references: [id], onDelete: Cascade)
  documentVersionId String?                  @map("document_version_id")
  documentVersion   ContractDocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)
  clauseKey         String                   @map("clause_key")
  title             String
  category          String
  text              String
  citation          String
  riskLevel         String                   @default("LOW") @map("risk_level")
  status            String                   @default("IDENTIFIED")
  fallbackText      String?                  @map("fallback_text")
  aiConfidence      Float?                   @map("ai_confidence")
  reviewedBy        String?                  @map("reviewed_by")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  obligations       ContractObligation[]

  @@unique([matterId, clauseKey])
  @@index([matterId, riskLevel, status])
  @@map("contract_clause")
}

model ContractObligation {
  id              String          @id @default(uuid())
  matterId        String          @map("matter_id")
  matter          ContractMatter  @relation(fields: [matterId], references: [id], onDelete: Cascade)
  clauseId        String?         @map("clause_id")
  clause          ContractClause? @relation(fields: [clauseId], references: [id], onDelete: SetNull)
  reference       String
  description     String
  ownerId         String          @map("owner_id")
  dueDate         DateTime?       @map("due_date")
  recurrence      String?
  status          String          @default("OPEN")
  evidenceUrl     String?         @map("evidence_url")
  escalationLevel Int             @default(0) @map("escalation_level")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@unique([matterId, reference])
  @@index([status, dueDate])
  @@map("contract_obligation")
}

model ContractMilestone {
  id          String         @id @default(uuid())
  matterId    String         @map("matter_id")
  matter      ContractMatter @relation(fields: [matterId], references: [id], onDelete: Cascade)
  reference   String
  name        String
  dueDate     DateTime       @map("due_date")
  status      String         @default("UPCOMING")
  ownerId     String         @map("owner_id")
  evidenceUrl String?        @map("evidence_url")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@unique([matterId, reference])
  @@index([status, dueDate])
  @@map("contract_milestone")
}

model ContractAmendment {
  id                String                   @id @default(uuid())
  matterId          String                   @map("matter_id")
  matter            ContractMatter           @relation(fields: [matterId], references: [id], onDelete: Cascade)
  documentVersionId String?                  @map("document_version_id")
  documentVersion   ContractDocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)
  amendmentNumber   String                   @map("amendment_number")
  title             String
  description       String
  effectiveDate     DateTime                 @map("effective_date")
  priceDelta        Float                    @default(0) @map("price_delta")
  impactSummary     String                   @map("impact_summary")
  riskLevel         String                   @default("MEDIUM") @map("risk_level")
  status            String                   @default("DRAFT")
  createdBy         String                   @map("created_by")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  @@unique([matterId, amendmentNumber])
  @@index([status, effectiveDate])
  @@map("contract_amendment")
}

model ContractApproval {
  id           String         @id @default(uuid())
  matterId     String         @map("matter_id")
  matter       ContractMatter @relation(fields: [matterId], references: [id], onDelete: Cascade)
  resourceType String         @map("resource_type")
  resourceId   String         @map("resource_id")
  step         String
  decision     String
  rationale    String
  actorId      String         @map("actor_id")
  createdAt    DateTime       @default(now()) @map("created_at")

  @@index([matterId, resourceType, resourceId])
  @@map("contract_approval")
}

model ContractRenewal {
  id               String         @id @default(uuid())
  matterId         String         @map("matter_id")
  matter           ContractMatter @relation(fields: [matterId], references: [id], onDelete: Cascade)
  optionPeriod     String         @map("option_period")
  noticeDeadline   DateTime       @map("notice_deadline")
  exerciseDeadline DateTime       @map("exercise_deadline")
  estimatedValue   Float          @default(0) @map("estimated_value")
  status           String         @default("MONITORING")
  recommendation   String
  ownerId          String         @map("owner_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@unique([matterId, optionPeriod])
  @@index([status, noticeDeadline])
  @@map("contract_renewal")
}

model ContractRiskAssessment {
  id                 String         @id @default(uuid())
  matterId           String         @map("matter_id")
  matter             ContractMatter @relation(fields: [matterId], references: [id], onDelete: Cascade)
  assessmentKey      String         @map("assessment_key")
  legalScore         Int            @map("legal_score")
  financialScore     Int            @map("financial_score")
  operationalScore   Int            @map("operational_score")
  cybersecurityScore Int            @map("cybersecurity_score")
  complianceScore    Int            @map("compliance_score")
  overallRating      String         @map("overall_rating")
  findings           Json
  assessedBy         String         @map("assessed_by")
  sourceDigest       String         @map("source_digest")
  createdAt          DateTime       @default(now()) @map("created_at")

  @@unique([matterId, assessmentKey])
  @@index([overallRating, createdAt])
  @@map("contract_risk_assessment")
}

model ContractTemplate {
  id            String    @id @default(uuid())
  templateKey   String    @map("template_key")
  version       Int
  name          String
  agency        String?
  contractType  String    @map("contract_type")
  content       String
  playbookRules Json      @map("playbook_rules")
  status        String    @default("DRAFT")
  approvedBy    String?   @map("approved_by")
  effectiveFrom DateTime? @map("effective_from")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([templateKey, version])
  @@index([status, contractType])
  @@map("contract_template")
}

model ContractAiReview {
  id           String         @id @default(uuid())
  matterId     String         @map("matter_id")
  matter       ContractMatter @relation(fields: [matterId], references: [id], onDelete: Cascade)
  reviewType   String         @map("review_type")
  promptDigest String         @map("prompt_digest")
  output       String
  model        String
  citations    Json
  confidence   Float?
  advisoryOnly Boolean        @default(true) @map("advisory_only")
  status       String         @default("PENDING_HUMAN_REVIEW")
  createdBy    String         @map("created_by")
  createdAt    DateTime       @default(now()) @map("created_at")

  @@index([matterId, createdAt])
  @@map("contract_ai_review")
}

model ContractIntegrationOutbox {
  id             String         @id @default(uuid())
  matterId       String         @map("matter_id")
  matter         ContractMatter @relation(fields: [matterId], references: [id], onDelete: Cascade)
  provider       String
  operation      String
  idempotencyKey String         @unique @map("idempotency_key")
  payload        Json
  status         String         @default("PENDING")
  attempts       Int            @default(0)
  nextAttemptAt  DateTime       @default(now()) @map("next_attempt_at")
  receipt        Json?
  lastErrorCode  String?        @map("last_error_code")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@map("contract_integration_outbox")
}

model ContractLifecycleAuditEvent {
  id           String   @id @default(uuid())
  aggregateId  String   @map("aggregate_id")
  sequence     Int
  action       String
  actorId      String   @map("actor_id")
  occurredAt   DateTime @map("occurred_at")
  payload      Json
  previousHash String   @map("previous_hash")
  hash         String   @unique

  @@unique([aggregateId, sequence])
  @@index([aggregateId, occurredAt])
  @@map("contract_lifecycle_audit_event")
}

model ContractCapabilityWorkItem {
  id              String                       @id @default(uuid())
  matterId        String                       @map("matter_id")
  matter          ContractMatter               @relation(fields: [matterId], references: [id], onDelete: Cascade)
  domain          String
  capability      String
  sourceProject   String                       @map("source_project")
  sourceRecordKey String                       @map("source_record_key")
  title           String
  summary         String
  status          String                       @default("OPEN")
  priority        String                       @default("MEDIUM")
  riskLevel       String                       @default("MEDIUM") @map("risk_level")
  ownerId         String                       @map("owner_id")
  counterparty    String?
  monetaryValue   Float?                       @map("monetary_value")
  probability     Float?
  dueDate         DateTime?                    @map("due_date")
  jurisdiction    String?
  chainId         String?                      @map("chain_id")
  league          String?
  evidence        Json
  recommendation  String
  approvedBy      String?                      @map("approved_by")
  approvedAt      DateTime?                    @map("approved_at")
  createdAt       DateTime                     @default(now()) @map("created_at")
  updatedAt       DateTime                     @updatedAt @map("updated_at")
  analyses        ContractCapabilityAnalysis[]

  @@unique([sourceProject, sourceRecordKey])
  @@index([domain, capability, status])
  @@index([matterId, riskLevel])
  @@index([ownerId, dueDate])
  @@map("contract_capability_work_item")
}

model ContractCapabilityAnalysis {
  id           String                     @id @default(uuid())
  workItemId   String                     @map("work_item_id")
  workItem     ContractCapabilityWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  analysisType String                     @map("analysis_type")
  inputDigest  String                     @map("input_digest")
  output       Json
  model        String
  confidence   Float?
  advisoryOnly Boolean                    @default(true) @map("advisory_only")
  status       String                     @default("PENDING_HUMAN_REVIEW")
  createdBy    String                     @map("created_by")
  createdAt    DateTime                   @default(now()) @map("created_at")

  @@index([workItemId, createdAt])
  @@map("contract_capability_analysis")
}
